<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key><string>app.sylvie.mac</string>
    <key>CFBundleName</key><string>Sylvie</string>
    <key>CFBundleDisplayName</key><string>Sylvie</string>
    <key>CFBundleExecutable</key><string>Sylvie</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.1.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>LSMinimumSystemVersion</key><string>26.0</string>
    <key>LSUIElement</key><true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>Sylvie listens for “Sylvie” and for your questions. Audio stays on your Mac and is deleted right after transcription.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Sylvie turns Spotify down while she listens to you, and back up afterwards.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Sylvie uses on-device speech recognition to notice when you say “Sylvie”. Nothing is sent to Apple.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Sylvie shows you the photos you ask for (“show me the photos with Ana”). They stay on your Mac.</string>
    <key>NSAppTransportSecurity</key>
    <dict><key>NSAllowsLocalNetworking</key><true/></dict>
</dict>
</plist>
